# Copy this file to .env on your VPS and fill the values. NEVER share .env with anyone.

PORT=3005

# Your store domain(s) allowed to call this API (comma separated)
ALLOWED_ORIGINS=https://biesca.in,https://www.biesca.in,https://stkdjn-0h.myshopify.com

# Long random secret (run: openssl rand -hex 32)
TOKEN_SECRET=change_me

# ---- AiSensy ----
AISENSY_API_KEY=
# Name of the API campaign you create in AiSensy using the approved OTP (Authentication) template
AISENSY_CAMPAIGN_NAME=biesca_otp_login
# Authentication templates have a "Copy code" button that also needs the OTP. Keep true for them.
AISENSY_OTP_BUTTON=true

# ---- Shopify (custom app: Settings > Apps > Develop apps) ----
# Scopes needed: read_customers, write_customers
SHOPIFY_STORE=stkdjn-0h.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Default country code if customer types 10-digit number
DEFAULT_COUNTRY_CODE=91
